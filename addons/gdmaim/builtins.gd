static func to_list_of_methods(raw : String) -> String:
	var methods : String
	
	var lines : PackedStringArray = raw.split("\n")
	for line in lines:
		var idx : int = line.find("(")
		if idx != -1:
			methods += '\n"' + line.substr(0, idx).replace(" ", "") + '",'
	
	return methods
